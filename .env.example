# Local account created on first boot. Change the password.
USER_EMAIL=peter@local
USER_PASSWORD=hub-of-me
USER_NAME=Peter

# mock runs the whole app with no model key.
# anthropic or gemini once the matching key is set.
AI_PROVIDER=mock

# Required only for that provider. Never commit real keys.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Production Postgres (Neon, Supabase, or any Postgres). Omit locally to use embedded PGlite.
DATABASE_URL=

# Signs the session cookie. Set a long random value before hosting.
SESSION_SECRET=

# EUR cap. 2000 cents is €20.
MONTHLY_CAP_EUR_CENTS=2000

# Market rate on 31 Oct 2026. Update it; costs are list price times this rate.
USD_TO_EUR=0.8959

# Optional. Gmail stays read-only even when these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=http://127.0.0.1:43123

# Set to true to let research call DuckDuckGo after the privacy guard.
SEARCH_ENABLED=false

HUB_PORT=43124
HUB_URL=http://127.0.0.1:43123
