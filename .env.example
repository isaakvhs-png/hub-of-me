# The one account. On every start, when both are set, the account is updated to match them.
USER_EMAIL=isaak@local
USER_PASSWORD=hub-of-me
USER_NAME=Isaak

# mock runs everything with the scripted model (no key; plumbing only). anthropic = the live route.
AI_PROVIDER=mock

# The plan route (Agent SDK on Isaak's Pro plan): `claude setup-token`. Never commit it.
CLAUDE_CODE_OAUTH_TOKEN=
# When the token was made (YYYY-MM-DD): the health checks remind a month before it expires.
CLAUDE_TOKEN_CREATED=
# Optional, pay per token; only used when the plan cannot answer.
ANTHROPIC_API_KEY=
# Gemini: embeddings (similar meaning) and the fallback model.
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001

# Optional model overrides per tier (defaults: haiku, sonnet, opus, opus).
MODEL_FAST=
MODEL_MAIN=
MODEL_DEEP=
MODEL_REVIEW=

# Production Postgres (Neon). Omit locally to use embedded PGlite in ./data/pglite.
DATABASE_URL=
SESSION_SECRET=

# GET /api/diag/* requires Authorization: Bearer <token>. Unset: diagnostics are off (404).
DIAGNOSTICS_TOKEN=

HUB_PORT=43124
